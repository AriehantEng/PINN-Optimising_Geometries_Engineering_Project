# Run outputs are written by the code and never edited by hand.
runs/
!runs/.gitkeep
# Finished bifurcation networks are kept: their weights are small, and a
# rebuilt container loses whatever git does not hold (it has, once, and the
# parametric network had to be retrained for 215 min). The checkpoint is
# training state for resuming, not a result.
!bifurcation/runs/
bifurcation/runs/*/checkpoint.npz
bifurcation/runs/*/checkpoint.tmp.npz
# Network 1's retrained networks too (developing_flow/network1_queue.sh); its
# finite-element reference is ~50 MB and is rebuilt by the queue in minutes.
!developing_flow/runs/
developing_flow/runs/*
!developing_flow/runs/developing_re10_lm_fresh_inputmap/
!developing_flow/runs/developing_re10_polish_g5_points*/
developing_flow/runs/*/checkpoint.npz
developing_flow/runs/*/checkpoint.tmp.npz

__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/
node_modules/
package-lock.json

# The study queue writes its logs while it runs; a failure is recorded beside its run.
docs/re_study/logs/
